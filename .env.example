# Liga o MSW (API REST + Socket.IO simulados no navegador). Padrão: true.
VITE_ENABLE_MOCKS=true
# Base da API REST consumida pelo Axios.
VITE_API_BASE_URL=/api
# URL do servidor Socket.IO (interceptado pelo MSW quando os mocks estão ativos).
VITE_SOCKET_URL=
# Timeout do Axios em milissegundos.
VITE_HTTP_TIMEOUT_MS=8000
# Mostra o painel de cenários (também pode ser aberto com ?dev=1).
VITE_SHOW_DEVTOOLS=false
